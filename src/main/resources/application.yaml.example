# ============================================================
# 如意商城 - 配置模板
#
# 用法：复制为同目录下的 application.yaml，再按需修改。
#
#     cp src/main/resources/application.yaml.example src/main/resources/application.yaml
#
# 为什么 application.yaml 不进版本库：
#   里面有数据库口令、JWT 签名密钥、阿里云 OSS AccessKey 这类凭证。
#   application.yaml 已在 .gitignore 中，本模板是可以安全提交的那一份。
#
# 带 ${XXX:默认值} 的是「环境变量优先」写法：
#   - 没有默认值的（OSS 两个密钥）属于真实凭证，必须用环境变量注入，
#     否则图片上传会因鉴权失败而报错（应用仍能正常启动）。
#   - 有默认值的属于本地开发约定值，生产环境请务必用环境变量覆盖。
# ============================================================

server:
  port: 8080
  servlet:
    encoding:
      charset: UTF-8
      enabled: true

spring:
  application:
    name: ruyi_mart
  profiles:
    active: dev
  servlet:
    multipart:
      max-file-size: 10MB        # 单文件最大 10MB
      max-request-size: 10MB     # 单次请求最大 10MB


  # ============ 数据源：MySQL 8 ============
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:ruyi_mart}?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: ${MYSQL_USERNAME:root}
    # 本地开发口令；生产请用环境变量 MYSQL_PASSWORD 覆盖，不要沿用这个值
    password: ${MYSQL_PASSWORD:123456}

  # ============ Redis ============
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      # password: ${REDIS_PASSWORD:}   # 本地没设密码就保持注释
      database: 0
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 2
          max-wait: 3000ms
          time-between-eviction-runs: 30s


  # ============ Jackson 时间序列化 ============
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8
    default-property-inclusion: non_null


rocketmq:
  name-server: ${ROCKETMQ_NAME_SERVER:localhost:9876}
  producer:
    group: ruyi_mart_producer_group


ruyi-mart:
  order:
    close-delay-level: 16   # RocketMQ 延迟级别：16=30分钟；测试时可临时改 2(=5秒) 观察自动关单


jwt:
  # JWT 签名密钥（HS256 要求至少 256 位 / 32 字节）。
  # 这里的默认值仅供本地开发；生产必须用环境变量 JWT_SECRET 覆盖，
  # 因为密钥一旦泄露，别人就能伪造任意用户的 token。
  secret: ${JWT_SECRET:dev-only-placeholder-secret-change-me-0123456789abcdef}
  # accessToken 有效期（秒）= 15 分钟
  access-expire: 900
  # refreshToken 有效期（秒）= 7 天
  refresh-expire: 604800

# ============ MyBatis-Plus ============
mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.ruyi.ruyi_mart.module.*.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl   # M1 调试用，上线可关
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# ============ SpringDoc API 文档 ============
springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    path: /swagger-ui.html
    enabled: true

# ============ 日志 ============
logging:
  level:
    com.ruyi.ruyi_mart: debug
    org.springframework.security: warn


# ============ 阿里云 OSS 配置 ============
# access-key-id / access-key-secret 是真实凭证，故意不给默认值：
# 请通过环境变量注入，例如 IDEA 的 Run Configuration → Environment variables
#     OSS_ACCESS_KEY_ID=xxx;OSS_ACCESS_KEY_SECRET=xxx
# 或启动时：--app.aliyun.oss.access-key-id=xxx --app.aliyun.oss.access-key-secret=xxx
# 未配置时应用仍能启动，只是图片上传会鉴权失败。
app:
  aliyun:
    oss:
      endpoint: ${OSS_ENDPOINT:oss-cn-hangzhou.aliyuncs.com}
      access-key-id: ${OSS_ACCESS_KEY_ID:}
      access-key-secret: ${OSS_ACCESS_KEY_SECRET:}
      bucket-name: ${OSS_BUCKET_NAME:ruyi-mart}
